{
  "name": "@google/jules-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Google Jules API with scheduling capabilities",
  "type": "module",
  "markdownlint-cli2": {
    "config": {
      "MD013": false,
      "MD024": {
        "siblings_only": true
      }
    }
  },
  "main": "dist/index.js",
  "bin": {
    "jules-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "mcp:smoke": "npm run build && node scripts/mcp-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jules",
    "google",
    "coding-agent",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^17.3.1",
    "node-schedule": "^2.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/node-schedule": "^2.1.7",
    "knip": "^5.86.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "knip": {
    "ignore": [
      "node_modules/.vite/**",
      "README.md",
      "docs/**"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
