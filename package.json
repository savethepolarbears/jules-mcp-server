{
  "name": "@google/jules-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Google Jules API with scheduling capabilities",
  "type": "module",
  "markdownlint-cli2": {
    "config": {
      "MD013": false,
      "MD024": {
        "siblings_only": true
      }
    }
  },
  "main": "dist/index.js",
  "bin": {
    "jules-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "mcp:smoke": "npm run build && node scripts/mcp-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jules",
    "google",
    "coding-agent",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.1",
    "node-schedule": "^2.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.17",
    "@types/node-schedule": "^2.1.7",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "knip": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.4"
  },
  "knip": {
    "ignore": [
      "node_modules/.vite/**",
      "node_modules/.cache/**",
      "pieces/**",
      ".gemini*",
      "README.md",
      "docs/**"
    ],
    "entry": [
      "src/index.ts"
    ],
    "project": [
      "src/**/*.ts"
    ],
    "vitest": {
      "config": [
        "vitest.config.ts"
      ]
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
